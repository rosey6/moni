*
!.gitignore
!README.md
!frontend/
frontend/*
!frontend/index.html
!frontend/package.json
!frontend/src/
!frontend/src/**
!frontend/public/
frontend/public/*
!frontend/public/assets/
frontend/public/assets/*
!frontend/public/assets/flags/
!frontend/public/assets/mascots/
frontend/public/assets/flags/*
!frontend/public/assets/flags/*.svg
!frontend/public/assets/flags/LICENSE
frontend/public/assets/mascots/*
!frontend/public/assets/mascots/*.png

# Publication frontend/QA/DevOps allowlist, appended while preserving main rules
!deployment/
!deployment/**
!frontend/README.md
!frontend/favicon.ico
!frontend/manifest.webmanifest
!frontend/qa_*.py
!frontend/run_browser_tests.py
!frontend/tests/
!frontend/tests/**
!frontend/src/styles/
!frontend/src/styles/**
!frontend/public/assets/brand/
!frontend/public/assets/brand/**
!frontend/public/assets/brands/
!frontend/public/assets/brands/**
!frontend/vendor/
!frontend/vendor/lucide-icons.mjs
!frontend/vendor/lucide-LICENSE.txt

# Local secrets and generated dependencies
**/.env
**/.env.*
!**/.env.example
**/secrets/**
**/*.pem
**/*.key
**/test.env
**/node_modules/
**/dist/
**/coverage/
**/playwright-report/
**/*.log
**/.DS_Store
**/Thumbs.db
**/vendor/
!frontend/vendor/
!frontend/vendor/lucide-icons.mjs
!frontend/vendor/lucide-LICENSE.txt

# Backend-bound integration artifacts are local-only
frontend/tests/e2e_backend_validation.py
frontend/tests/artifacts_backend_validation/
frontend/tests/__pycache__/


# Additional validated assets from the approved frontend candidate
!frontend/pnpm-lock.yaml
!frontend/sw.js
!frontend/public/icons/
!frontend/public/icons/**
!frontend/public/assets/mascots/validated/
!frontend/public/assets/mascots/validated/**
!frontend/public/assets/savings/
!frontend/public/assets/savings/**

# Backend publication allowlist: source, schema/migrations, test code and setup files only.
!backend/
backend/*
!backend/.env.example
!backend/README.md
!backend/composer.json
!backend/composer.lock
!backend/*.php
!backend/lib/
backend/lib/*
!backend/lib/*.php
!backend/migrations/
backend/migrations/*
!backend/migrations/*.sql
!backend/tests/
backend/tests/*
!backend/tests/validation_guard.py
!backend/tests/fixtures/
backend/tests/fixtures/*
!backend/tests/fixtures/*.test.json
!backend/tests/integration/
backend/tests/integration/*
!backend/tests/integration/*.php
!backend/tests/integration/*.py
!backend/tests/security/
backend/tests/security/*
!backend/tests/security/*.php
!backend/tests/security/*.py
!backend/tests/unit/
backend/tests/unit/*
!backend/tests/unit/*.php
